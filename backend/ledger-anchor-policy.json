{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::forentrace-ledger-anchors"],
      "Condition": {"StringLike": {"s3:prefix": ["ledgers/*"]}}
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectRetention", "s3:GetObject", "s3:GetObjectRetention"],
      "Resource": ["arn:aws:s3:::forentrace-ledger-anchors/ledgers/*"]
    }
  ]
}
